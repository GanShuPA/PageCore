{
  "name": "pagecore",
  "version": "0.4.0",
  "description": "页核 PAGECORE — a local-first Markdown editor for Windows",
  "license": "MIT",
  "repository": "github:GanShuPA/PageCore-Markdown",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15 <25"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint src scripts tests *.js *.mjs *.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm test",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@milkdown/crepe": "7.22.3",
    "@milkdown/kit": "7.22.3",
    "@milkdown/utils": "7.22.3",
    "codemirror": "6.0.2",
    "docx": "9.10.0",
    "dompurify": "3.4.17",
    "katex": "0.19.0",
    "marked": "18.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "jszip": "3.10.1",
    "prettier": "3.9.10"
  }
}
